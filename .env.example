"""Local development environment file for NEXORA AI."""

# Database
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora_db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# Azure OpenAI
AZURE_OPENAI_SERVICE=your-service-name
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4-turbo
AZURE_OPENAI_CHATGPT_MODEL=gpt-4-turbo
AZURE_OPENAI_EMB_DEPLOYMENT=embeddings
AZURE_OPENAI_EMB_MODEL_NAME=text-embedding-3-large
AZURE_OPENAI_EMB_DIMENSIONS=1536

# Azure Search
AZURE_SEARCH_SERVICE=your-search-service
AZURE_SEARCH_INDEX=documents
AZURE_SEARCH_KNOWLEDGEBASE_NAME=nexora-kb

# Azure Storage
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=documents
AZURE_IMAGESTORAGE_CONTAINER=images
AZURE_USERSTORAGE_ACCOUNT=your-userstorage-account
AZURE_USERSTORAGE_CONTAINER=userdata

# Features
USE_USER_UPLOAD=true
USE_MULTIMODAL=true
USE_VECTORS=true
USE_CHAT_HISTORY_BROWSER=true
USE_AGENTIC_KNOWLEDGEBASE=true
ENABLE_LANGUAGE_PICKER=true

# Security
AZURE_USE_AUTHENTICATION=false
AZURE_ENFORCE_ACCESS_CONTROL=false
AZURE_ENABLE_UNAUTHENTICATED_ACCESS=true

# Logging
APP_LOG_LEVEL=INFO
SQL_ECHO=false

# CORS
ALLOWED_ORIGIN=http://localhost:5173
